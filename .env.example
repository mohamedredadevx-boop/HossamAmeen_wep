NODE_ENV=production
HOST=127.0.0.1
# Nginx on the same VPS is the only public entry point and appends the observed client IP.
TRUST_PROXY=true
# Set PORT only if your hosting panel does not provide one.
# PORT=3000
# Public HTTPS origin used for canonical URLs and sitemap generation.
SITE_URL=https://your-real-domain.example
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admainMain1@gmail.com
ADMIN_PASSWORD=replace-with-a-unique-14-plus-character-password-with-mixed-letters-number-symbol
# Set these to directories outside deployment/build folders that persist across releases.
AMEEN_DATA_DIR=/home/USER/private/ameen-data
AMEEN_UPLOAD_DIR=/home/USER/private/ameen-uploads
# Production uploads are rejected unless ClamAV reports them clean.
AV_SCAN_REQUIRED=true
CLAMSCAN_PATH=/usr/bin/clamscan
# Optional override; by default the SQLite database is AMEEN_DATA_DIR/ameen.sqlite.
# AMEEN_DATABASE_PATH=/home/USER/private/ameen-data/ameen.sqlite
# Optional email delivery settings:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# FawryPay: leave unset to disable checkout safely until the merchant account is ready.
# FAWRY_MERCHANT_CODE=your-live-merchant-code
# FAWRY_SECURE_KEY=your-live-secure-key
# FAWRY_WEBHOOK_URL=https://example.com/api/payments/fawry/webhook
# Optional; defaults to staging in development and production Fawry in NODE_ENV=production.
# FAWRY_API_URL=https://atfawry.fawrystaging.com/ECommerceWeb/Fawry/payments/charge

# For the first boot with an existing database only: set both reset values to the same strong password,
# then remove RESET_ADMIN_PASSWORD and ADMIN_RESET_PASSWORD after the server starts successfully.
# RESET_ADMIN_PASSWORD=true
# ADMIN_RESET_PASSWORD=replace-with-the-same-strong-password-as-ADMIN_PASSWORD
